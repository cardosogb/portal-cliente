# Copie para .env e preencha com valores reais (nunca commitar o .env).

# Token da API do ADVBOX (https://api.softwareadvbox.com.br/docs).
# Com ele definido, a API usa dados reais do ADVBOX em vez dos mockados
# (ver apps/api/src/integrations/advboxAdapter.ts). Sem ele, continua
# tudo mockado normalmente — não precisa disso pra rodar em dev/demo.
ADVBOX_API_TOKEN=

# Obrigatório em produção (NODE_ENV=production) — ver apps/api/src/auth.ts.
JWT_SECRET=

# Origens permitidas a chamar a API em produção, separadas por vírgula.
# ALLOWED_ORIGINS=https://portal.fernandomiranda.adv.br
